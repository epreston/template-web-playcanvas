{
  "private": true,
  "type": "module",
  "name": "playcanvas-template",
  "version": "2.0.0",
  "license": "MIT",
  "browserslist": [
    "baseline 2025"
  ],
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "start": "vite --open",
    "lint": "eslint --ext .js,.ts --report-unused-disable-directives .",
    "format": "prettier --write \"**/*.[tj]s?(x)\""
  },
  "devDependencies": {
    "@playcanvas/eslint-config": "^2.1.0",
    "eslint": "^9.39.3",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "playcanvas": "^2.21.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
